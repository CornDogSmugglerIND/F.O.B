# Channel secrets — names only. Copy to .env / Vercel / Cursor secrets.
# Never commit real values. Never paste keys in chat.

# --- eBay (Developer Program — Sell Inventory API) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
EBAY_RU_NAME=
EBAY_REFRESH_TOKEN=
EBAY_ACCESS_TOKEN=
EBAY_SELLER_ID=
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_US
# Business policies (Account API) — required to publish offers
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=

# --- Double Holo ---
DOUBLE_HOLO_API_KEY=
DOUBLE_HOLO_API_BASE=
DOUBLE_HOLO_STORE_ID=
DOUBLE_HOLO_WEBHOOK_SECRET=

# --- Cloudflare R2 (scan PicURLs for Double Holo Import photos) ---
# Custom domain: scans.corndogsmugglercoalition.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://scans.corndogsmugglercoalition.com
R2_KEY_PREFIX=scans

# --- Misprint ---
# Paste key + seller id into Cursor chat if needed — agent stores in gitignored .env.
# MISPRINT_API_BASE is the host from Misprint’s API/key screen (required for live calls).
MISPRINT_API_KEY=
MISPRINT_API_SECRET=
MISPRINT_SELLER_ID=
MISPRINT_API_BASE=
MISPRINT_WEBHOOK_SECRET=

# --- Shared sync ---
CHANNEL_SYNC_SECRET=
CANONICAL_INVENTORY=hud

# --- Identify Path 3 (photo + live search) ---
# Same key GitHub Actions already uses for Claude workflows.
# Mirror into Cursor Cloud Secrets + Vercel. Never commit the value.
ANTHROPIC_API_KEY=
# Optional override; default claude-sonnet-4-20250514
IDENTIFY_VISION_MODEL=
